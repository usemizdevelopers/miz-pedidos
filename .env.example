NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Conexão direta com o Postgres, usada só para aplicar migrações (npm run db:push).
# Supabase > Connect > Session pooler. Troque [YOUR-PASSWORD] pela senha do banco.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:5432/postgres

ADMIN_EMAIL=admin@exemplo.com
